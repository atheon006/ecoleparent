rules_version = '2';

// Règles de sécurité ParentEcole.
// Personnel : document members/{email}, e-mail vérifié ET connexion avec le code
//             d'une application d'authentification (double authentification TOTP).
// Super-administrateurs : document superadmins/{email}, créé à la main dans la console.
// Parents : students/{id}/parents/{uid}, créé seulement si le téléphone donné
//           figure dans student.parentPhoneKeys.

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Fonctions ───────────────────────────────────────────────────────────

    function signedIn() {
      return request.auth != null;
    }

    function myEmail() {
      return request.auth.token.email.lower();
    }

    function verified() {
      return signedIn() && request.auth.token.email_verified == true;
    }

    // Jeton obtenu avec un second facteur (code à 6 chiffres d'une application d'authentification).
    function hasSecondFactor() {
      return signedIn() && 'sign_in_second_factor' in request.auth.token.firebase;
    }

    function memberPath() {
      return /databases/$(database)/documents/members/$(myEmail());
    }

    function me() {
      return get(memberPath()).data;
    }

    function isMember() {
      return verified() && hasSecondFactor() && exists(memberPath()) && me().active == true;
    }

    function isSuper() {
      return verified() && hasSecondFactor() && exists(/databases/$(database)/documents/superadmins/$(myEmail()));
    }

    function inSchool(schoolId) {
      return isMember() && me().schoolId == schoolId;
    }

    function hasRole(schoolId, roles) {
      return inSchool(schoolId) && me().role in roles;
    }

    function isAdmin(schoolId) {
      return isSuper() || hasRole(schoolId, ['admin']);
    }

    function isStaff(schoolId) {
      return isSuper() || inSchool(schoolId);
    }

    function isSchoolParent(schoolId) {
      return signedIn()
        && exists(/databases/$(database)/documents/schoolParents/$(schoolId + '_' + request.auth.uid));
    }

    function studentSchool(studentId) {
      return get(/databases/$(database)/documents/students/$(studentId)).data.schoolId;
    }

    function isParentOf(studentId) {
      return signedIn()
        && exists(/databases/$(database)/documents/students/$(studentId)/parents/$(request.auth.uid));
    }

    function canTakeAttendance(schoolId, classId) {
      return isSuper()
        || hasRole(schoolId, ['admin', 'surveillant'])
        || (hasRole(schoolId, ['professeur']) && classId in me().classIds);
    }

    function onlyChanged(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    function validMember(email) {
      let d = request.resource.data;
      return d.email == email
        && email == email.lower()
        && d.role in ['admin', 'surveillant', 'professeur', 'caissier']
        && d.schoolId is string
        && d.active is bool
        && d.classIds is list;
    }

    function validStudent() {
      let d = request.resource.data;
      return d.schoolId is string
        && d.classId is string
        && d.matricule is string
        && d.parentPhoneKeys is list
        && d.firstName is string && d.firstName.size() > 0
        && d.lastName is string && d.lastName.size() > 0;
    }

    // ── Comptes ─────────────────────────────────────────────────────────────

    match /superadmins/{email} {
      allow read: if signedIn() && email == myEmail();
      allow write: if false;
    }

    match /members/{email} {
      allow read: if (signedIn() && email == myEmail())
        || isSuper()
        || isAdmin(resource.data.schoolId);
      allow create: if (isSuper() || isAdmin(request.resource.data.schoolId)) && validMember(email);
      allow update: if (isSuper()
          || (isAdmin(resource.data.schoolId) && request.resource.data.schoolId == resource.data.schoolId))
        && validMember(email);
      allow delete: if isSuper() || (isAdmin(resource.data.schoolId) && email != myEmail());
    }

    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // ── Écoles ──────────────────────────────────────────────────────────────

    match /schools/{schoolId} {
      allow read: if isStaff(schoolId) || isSchoolParent(schoolId);
      allow create, delete: if isSuper();
      allow update: if isSuper()
        || (isAdmin(schoolId) && onlyChanged(['name', 'address', 'phone', 'currency']));

      match /classes/{id} {
        allow read: if isStaff(schoolId) || isSchoolParent(schoolId);
        allow write: if isAdmin(schoolId);
      }

      match /fees/{id} {
        allow read: if isStaff(schoolId) || isSchoolParent(schoolId);
        allow write: if isAdmin(schoolId);
      }

      match /announcements/{id} {
        allow read: if isStaff(schoolId) || isSchoolParent(schoolId);
        allow write: if isAdmin(schoolId);
      }

      match /events/{id} {
        allow read: if isStaff(schoolId) || isSchoolParent(schoolId);
        allow write: if isAdmin(schoolId);
      }

      match /homework/{id} {
        allow read: if isStaff(schoolId) || isSchoolParent(schoolId);
        allow create: if isAdmin(schoolId)
          || (hasRole(schoolId, ['professeur'])
              && request.resource.data.classId in me().classIds
              && request.resource.data.createdBy == myEmail());
        allow update, delete: if isAdmin(schoolId)
          || (hasRole(schoolId, ['professeur']) && resource.data.createdBy == myEmail());
      }
    }

    // ── Élèves ──────────────────────────────────────────────────────────────

    match /codes/{code} {
      // Lecture par ID uniquement : impossible de lister les matricules.
      allow get: if signedIn();
      allow list: if false;
      allow create: if isAdmin(request.resource.data.schoolId);
      allow delete: if isAdmin(resource.data.schoolId);
      allow update: if false;
    }

    match /schoolParents/{id} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow create, update: if signedIn()
        && id == request.resource.data.schoolId + '_' + request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && existsAfter(/databases/$(database)/documents/students/$(request.resource.data.studentId)/parents/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/students/$(request.resource.data.studentId)).data.schoolId == request.resource.data.schoolId;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /students/{studentId} {
      allow read: if isStaff(resource.data.schoolId) || isParentOf(studentId);
      allow create: if isAdmin(request.resource.data.schoolId) && validStudent();
      allow update: if isAdmin(resource.data.schoolId)
        && request.resource.data.schoolId == resource.data.schoolId
        && request.resource.data.matricule == resource.data.matricule
        && validStudent();
      allow delete: if isAdmin(resource.data.schoolId);

      match /parents/{uid} {
        allow read: if (signedIn() && uid == request.auth.uid) || isStaff(studentSchool(studentId));
        allow create: if signedIn()
          && uid == request.auth.uid
          && request.resource.data.uid == uid
          && request.resource.data.studentId == studentId
          && request.resource.data.schoolId == studentSchool(studentId)
          && request.resource.data.phone is string
          && request.resource.data.phone.size() == 9
          && request.resource.data.phone in get(/databases/$(database)/documents/students/$(studentId)).data.parentPhoneKeys;
        allow delete: if (signedIn() && uid == request.auth.uid) || isAdmin(studentSchool(studentId));
      }

      match /attendance/{date} {
        allow read: if isParentOf(studentId) || isStaff(studentSchool(studentId));
        allow create: if canTakeAttendance(studentSchool(studentId), request.resource.data.classId)
          && request.resource.data.schoolId == studentSchool(studentId)
          && request.resource.data.studentId == studentId
          && request.resource.data.date == date
          && request.resource.data.status in ['present', 'absent', 'late', 'excused'];
        allow update: if (canTakeAttendance(studentSchool(studentId), request.resource.data.classId)
            && request.resource.data.schoolId == studentSchool(studentId)
            && request.resource.data.studentId == studentId
            && request.resource.data.date == date
            && request.resource.data.status in ['present', 'absent', 'late', 'excused'])
          || (isParentOf(studentId)
            && resource.data.status in ['absent', 'late']
            && onlyChanged(['justification', 'justifiedAt', 'justificationStatus'])
            && request.resource.data.justificationStatus == 'pending'
            && request.resource.data.justification is string
            && request.resource.data.justification.size() > 0);
        allow delete: if isAdmin(studentSchool(studentId));
      }

      match /payments/{id} {
        allow read: if isParentOf(studentId)
          || isSuper()
          || hasRole(studentSchool(studentId), ['admin', 'caissier']);
        allow create: if (isSuper() || hasRole(studentSchool(studentId), ['admin', 'caissier']))
          && request.resource.data.schoolId == studentSchool(studentId)
          && request.resource.data.studentId == studentId
          && request.resource.data.amount is number
          && request.resource.data.amount > 0
          && request.resource.data.recordedBy == myEmail();
        allow update: if isAdmin(studentSchool(studentId))
          && request.resource.data.schoolId == resource.data.schoolId
          && request.resource.data.studentId == studentId;
        allow delete: if isAdmin(studentSchool(studentId));
      }

      match /conduct/{id} {
        allow read: if isParentOf(studentId) || isStaff(studentSchool(studentId));
        allow create: if isStaff(studentSchool(studentId))
          && request.resource.data.schoolId == studentSchool(studentId)
          && request.resource.data.studentId == studentId
          && request.resource.data.createdBy == myEmail();
        allow delete: if isAdmin(studentSchool(studentId))
          || (isStaff(studentSchool(studentId)) && resource.data.createdBy == myEmail());
      }

      match /homeworkSeen/{homeworkId} {
        allow read: if isParentOf(studentId) || isStaff(studentSchool(studentId));
        allow create, update: if isParentOf(studentId)
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.studentId == studentId
          && request.resource.data.homeworkId == homeworkId
          && request.resource.data.schoolId == studentSchool(studentId);
        allow delete: if isParentOf(studentId);
      }
    }

    // ── Notifications push ──────────────────────────────────────────────────
    // Le personnel dépose une demande qui pointe vers ce qu'il vient d'enregistrer ; le Worker
    // d'envoi (compte de service, hors règles) relit ces documents et vérifie l'école.

    match /notifications/{id} {
      allow create: if isStaff(request.resource.data.schoolId)
        && request.resource.data.keys().hasOnly(['schoolId', 'kind', 'paths', 'status', 'createdBy', 'createdAt'])
        && request.resource.data.kind in ['attendance', 'payment', 'conduct', 'homework', 'announcement']
        && request.resource.data.status == 'pending'
        && request.resource.data.createdBy == myEmail()
        && request.resource.data.paths is list
        && request.resource.data.paths.size() > 0
        && request.resource.data.paths.size() <= 10;
      allow read, update, delete: if false;
    }

    // ── Lectures à l'échelle de l'école (groupes de collections) ───────────

    match /{path=**}/attendance/{date} {
      allow read: if isStaff(resource.data.schoolId);
    }

    match /{path=**}/payments/{id} {
      allow read: if isSuper() || hasRole(resource.data.schoolId, ['admin', 'caissier']);
    }

    match /{path=**}/conduct/{id} {
      allow read: if isStaff(resource.data.schoolId);
    }

    match /{path=**}/homeworkSeen/{homeworkId} {
      allow read: if isStaff(resource.data.schoolId);
    }

    match /{path=**}/parents/{uid} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
    }
  }
}

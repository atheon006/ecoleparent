# Copiez ce fichier en « .env » et remplissez-le (console Firebase › Paramètres du projet ›
# Vos applications › Application Web › Configuration du SDK).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Connexion Google dans l'APK : console Firebase › Authentication › Google ›
# « Configuration du SDK Web » › ID client Web (se termine par .apps.googleusercontent.com).
VITE_GOOGLE_WEB_CLIENT_ID=

# Adresse du site de l'école, affichée aux parents sur l'écran de connexion de l'app.
VITE_ECOLE_URL=
# Adresse de l'espace parent en ligne, affichée sur le site de l'école.
VITE_PARENT_URL=

# Notifications push dans l'APK : « true » seulement avec google-services.json (voir README).
VITE_PUSH_ENABLED=false

# Développement local contre les émulateurs Firebase.
VITE_USE_EMULATORS=false

# Adresse du Worker d'envoi des notifications (dossier push/), pour le site de l'école.
VITE_PUSH_URL=
